{
  "name": "flor-de-cacau",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "node --env-file-if-exists=.env.local scripts/start.ts",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "test:unit": "node --env-file-if-exists=.env.local --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "bash scripts/test-e2e.sh",
    "test:e2e:run": "playwright test",
    "test:e2e:report": "playwright show-report",
    "format": "prettier --write src scripts tests *.ts *.json *.yaml README.md docs",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.17",
    "@lucide/svelte": "1.68.0",
    "better-auth": "1.7.17",
    "bits-ui": "2.20.5",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "heic-convert": "2.1.0",
    "marked": "18.1.3",
    "pg": "8.23.1",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@internationalized/date": "3.12.4",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-node": "6.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
